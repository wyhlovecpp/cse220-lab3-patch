+      /* Snapshot the L1 victim's dirty bit NOW, before cache_insert can
+       * reuse/overwrite the Dcache_Data slot. */
+      Flag l1_victim_dirty_snap = (l1_repl_valid && l1_repl_data && l1_repl_data->dirty)
+                                      ? TRUE : FALSE;
+
+      /*
+       * Probe + remove the VC line for `va`.  take() vacates the slot on
+       * hit, so after a successful take the VC is guaranteed to have at
+       * least one free slot for the swap.  We check the peek-evict
+       * predicate AFTER take() — the swap-on-hit case therefore never
+       * requires a VC writeback (no entry is displaced).
+       */
+      Flag vc_dirty = FALSE;
+      if (victim_cache_take(op->proc_id, op->oracle_info.va, &vc_dirty)) {
+        /* post-take: sanity — if l1_repl_valid, pushing its line into the
+         * VC cannot require evicting anything, because take() just made
+         * room.  Assert in debug; otherwise trust and continue. */
+        DEBUG(op->proc_id, "VC swap-hit on addr 0x%s (l1 victim 0x%s)\n",
+              hexstr64s(op->oracle_info.va), hexstr64s(l1_repl_addr));
+
+        /* Commit the swap: install the VC line into the L1. */
+        Addr new_l1_line_addr = 0, repl_addr_out = 0;
+        Dcache_Data* new_line = (Dcache_Data*)cache_insert(
+            &dc->dcache, op->proc_id, op->oracle_info.va,
+            &new_l1_line_addr, &repl_addr_out);
