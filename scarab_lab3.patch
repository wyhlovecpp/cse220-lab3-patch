+        STAT_EVENT(op->proc_id, DCACHE_VC_HIT);
+
+        /* Treat as an L1 hit. dcache_cacheline_hit emits DCACHE_HIT_ONPATH
+         * and increments the line's read/write counters — we intentionally
+         * left them at zero above so they are not double-counted. */
+        dcache_cacheline_hit(op, new_l1_line_addr, new_line);
+        continue;
+      }
+    }
