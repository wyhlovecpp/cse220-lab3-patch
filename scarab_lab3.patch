+      Addr l1_repl_addr = 0;
+      Flag l1_repl_valid = FALSE;
+      Dcache_Data* l1_repl_data = (Dcache_Data*)get_next_repl_line(
+          &dc->dcache, op->proc_id, op->oracle_info.va,
+          &l1_repl_addr, &l1_repl_valid);
