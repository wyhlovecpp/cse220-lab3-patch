+        new_line->HW_prefetch = FALSE;
+        new_line->HW_prefetched = FALSE;
+        new_line->read_count[0] = 0; new_line->read_count[1] = 0;
+        new_line->write_count[0] = 0; new_line->write_count[1] = 0;
+        new_line->misc_state = 0;
+        new_line->fetched_by_offpath = FALSE;
+        new_line->offpath_op_addr = 0;
+        new_line->offpath_op_unique = 0;
+        new_line->fetch_cycle = cycle_count;
+        new_line->onpath_use_cycle = cycle_count;
